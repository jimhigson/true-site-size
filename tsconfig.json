{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    // run the .ts source directly on node >= 23.6 (type stripping), and bundle
    // it with esbuild for the shipped dist - so imports use real .ts extensions
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"]
}
